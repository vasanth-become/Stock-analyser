generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  plan          Plan      @default(FREE)
  onboarded     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       InvestorProfile?
  watchlists    Watchlist[]
  analyses      Analysis[]
  alerts        Alert[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model InvestorProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  displayName      String
  age              Int
  monthlyIncome    Float
  experience       InvestmentExperience
  riskTolerance    RiskTolerance      @default(MODERATE)
  investmentGoals  String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks    WatchlistStock[]

  @@map("watchlists")
}

model WatchlistStock {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  exchange    Exchange  @default(NSE)
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@map("watchlist_stocks")
}

model Analysis {
  id        String       @id @default(cuid())
  userId    String
  symbol    String
  exchange  Exchange     @default(NSE)
  type      AnalysisType
  content   String       @db.Text
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analyses")
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  exchange  Exchange  @default(NSE)
  type      AlertType
  value     Float
  triggered Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Exchange {
  NSE
  BSE
}

enum InvestmentExperience {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum AnalysisType {
  TECHNICAL
  FUNDAMENTAL
  AI_SUMMARY
  SENTIMENT
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE
  VOLUME_SPIKE
}
