generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String?
  password             String?
  emailVerified        DateTime?
  image                String?
  role                 Role                @default(USER)
  plan                 Plan                @default(FREE)
  onboarded            Boolean             @default(false)
  // Subscription fields
  razorpayCustomerId   String?             @unique
  subscriptionId       String?             @unique  // Razorpay subscription_id
  subscriptionStatus   SubscriptionStatus?
  planExpiresAt        DateTime?
  billingCycle         BillingCycle?
  monthlyAnalysisCount Int              @default(0)
  lastAnalysisReset    DateTime         @default(now())
  digestEnabled        Boolean          @default(false)
  isTestAccount        Boolean          @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  profile              InvestorProfile?
  watchlists           Watchlist[]
  analyses             Analysis[]
  alerts               Alert[]
  sessions             Session[]
  accounts             Account[]
  portfolio            Portfolio?
  subscriptionEvents   SubscriptionEvent[]
  behaviourEvents      BehaviourEvent[]
  behaviourScore       BehaviourScore?
  behaviourAlerts      BehaviourAlert[]

  @@map("users")
}

model BehaviourEvent {
  id             String   @id @default(cuid())
  userId         String
  eventType      String   // "panic_detected" | "panic_overridden" | "calm_confirmed" | "sell_prevented" | "thesis_checked"
  marketDrop     Float
  userAction     String?
  stocksAffected String[]
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("behaviour_events")
}

model BehaviourScore {
  id            String   @id @default(cuid())
  userId        String   @unique
  score         Int      @default(50)
  totalEvents   Int      @default(0)
  panicsStopped Int      @default(0)
  sipsKept      Int      @default(0)
  holdingsKept  Int      @default(0)
  badDecisions  Int      @default(0)
  lastUpdated   DateTime @default(now())
  badges        String[]

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("behaviour_scores")
}

model BehaviourAlert {
  id           String   @id @default(cuid())
  userId       String
  alertType    String   // "market_crash" | "stock_crash" | "portfolio_down"
  triggerValue Float
  message      String   @db.Text
  wasRead      Boolean  @default(false)
  userResponse String?  // "stay_course" | "research_more" | "ignored"
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, wasRead])
  @@map("behaviour_alerts")
}

model SubscriptionEvent {
  id              String              @id @default(cuid())
  userId          String
  event           String              // e.g. "subscription.activated", "payment.captured"
  razorpayEventId String?             @unique
  plan            Plan
  amount          Int?                // paise
  status          SubscriptionStatus
  payload         String              @db.Text   // raw webhook JSON
  createdAt       DateTime            @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("subscription_events")
}

model InvestorProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  displayName        String
  age                Int
  monthlyIncome      Float
  experience         InvestmentExperience
  riskScore          Int?
  riskTolerance      RiskTolerance        @default(MODERATE)
  investmentGoals    String[]
  sectorPreferences  String[]
  sipBudget          Float?
  hasLumpSum         Boolean              @default(false)
  lumpSumAmount      Float?
  investmentHorizon  InvestmentHorizon?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks    WatchlistStock[]

  @@map("watchlists")
}

model WatchlistStock {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  exchange    Exchange  @default(NSE)
  notes       String?   @db.Text
  addedAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@map("watchlist_stocks")
}

model Portfolio {
  id        String    @id @default(cuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings  Holding[]

  @@map("portfolios")
}

model Holding {
  id          String   @id @default(cuid())
  portfolioId String
  symbol      String
  exchange    Exchange @default(NSE)
  companyName String?
  sector      String?
  quantity    Float
  buyPrice    Float
  buyDate     DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("holdings")
}

model Analysis {
  id              String       @id @default(cuid())
  userId          String
  symbol          String       @default("PORTFOLIO")
  exchange        Exchange     @default(NSE)
  type            AnalysisType
  recommendations String       @db.Text
  profileSnapshot String       @db.Text
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("analyses")
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  exchange    Exchange  @default(NSE)
  type        AlertType
  value       Float
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  notifiedAt  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, triggered])
  @@map("alerts")
}

model MonthlyApiUsage {
  id            String   @id @default(cuid())
  month         String   @unique  // format: "2025-06"
  totalCalls    Int      @default(0)
  estimatedCost Float    @default(0)
  lastUpdated   DateTime @default(now()) @updatedAt

  @@map("monthly_api_usage")
}

model AdminLog {
  id           String   @id @default(cuid())
  action       String
  targetEmail  String?
  performedBy  String
  createdAt    DateTime @default(now())

  @@map("admin_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Exchange {
  NSE
  BSE
}

enum InvestmentExperience {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum InvestmentHorizon {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum AnalysisType {
  TECHNICAL
  FUNDAMENTAL
  AI_SUMMARY
  SENTIMENT
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE
  VOLUME_SPIKE
}
