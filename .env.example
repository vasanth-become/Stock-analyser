# ─────────────────────────────────────────────────────────
# DATABASE
# PostgreSQL connection string
# Local:  postgresql://USER:PASSWORD@localhost:5432/stockanalyser
# Docker: postgresql://postgres:postgres@postgres:5432/stockanalyser
# Cloud:  Use Neon, Supabase, Railway, or Render URLs
# ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/stockanalyser"

# ─────────────────────────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_URL: Full URL of your app (no trailing slash)
# NEXTAUTH_SECRET: Random 32-byte string
#   Generate: openssl rand -base64 32
# ─────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-openssl-rand-base64-32"

# ─────────────────────────────────────────────────────────
# GOOGLE OAUTH
# Create credentials at: https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────────────────
# ANTHROPIC (Claude AI) — REQUIRED
# Get your key at: https://console.anthropic.com
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENV="development"   # change to "production" on deploy

# ─────────────────────────────────────────────────────────
# ADMIN & SPEND GUARD
# ADMIN_EMAIL: Receives spend-limit warnings and is seeded as admin
# MONTHLY_SPEND_LIMIT: USD cap on estimated Claude API spend (default: 50)
# ─────────────────────────────────────────────────────────
ADMIN_EMAIL="ivasanthravi@gmail.com"
MONTHLY_SPEND_LIMIT="50"

# ─────────────────────────────────────────────────────────
# RAZORPAY (Indian payments — optional, required for Pro subscriptions)
# Dashboard: https://dashboard.razorpay.com
# ─────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="your-key-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
# RAZORPAY_PLAN_MONTHLY="plan_..."
# RAZORPAY_PLAN_YEARLY="plan_..."

# ─────────────────────────────────────────────────────────
# EMAIL (Resend — optional, required for alerts and digests)
# Sign up at https://resend.com — free tier: 3,000 emails/month
# Verify your domain in the Resend dashboard first
# ─────────────────────────────────────────────────────────
# RESEND_API_KEY="re_..."
# EMAIL_FROM="StockAnalyser <alerts@yourdomain.com>"

# ─────────────────────────────────────────────────────────
# UPSTASH REDIS (rate limiting — optional, skipped if not set)
# Create a free Redis database at: https://upstash.com
# Copy the REST URL and token from the console
# ─────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ─────────────────────────────────────────────────────────
# SENTRY (error tracking — optional, skipped if not set)
# Create a project at: https://sentry.io
# SENTRY_DSN: used server-side (never exposed to browser)
# NEXT_PUBLIC_SENTRY_DSN: exposed to the browser bundle
# SENTRY_AUTH_TOKEN: required only for source map uploads during CI/CD
# ─────────────────────────────────────────────────────────
# SENTRY_DSN="https://key@sentry.io/project-id"
# NEXT_PUBLIC_SENTRY_DSN="https://key@sentry.io/project-id"
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="stockanalyser"
# SENTRY_AUTH_TOKEN="sntrys_..."

# ─────────────────────────────────────────────────────────
# CRON (optional — protect cron endpoints from public access)
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────────────────
# CRON_SECRET="your-random-hex-secret"

# ─────────────────────────────────────────────────────────
# LOCAL DOCKER REDIS (docker-compose only)
# ─────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"
